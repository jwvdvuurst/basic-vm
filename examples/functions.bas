REM Calls may appear before their function definitions.
PRINT "Square: "; SQUARE(7)
PRINT "Factorial: "; FACTORIAL(6)
PRINT GREETING$("Ada")
CALL HELLO

VALUES = LIST(1, 2)
CALL ADD_VALUE(VALUES, 3)
FOR EACH VALUE IN VALUES
PRINT "Value: "; VALUE
NEXT
END

FUNCTION SQUARE(PARAMETER N)
    LOCAL RESULT
    RESULT = N * N
    SQUARE = RESULT
FEND

FUNCTION FACTORIAL(PARAMETER N)
    FACTORIAL = 1
    IF N <= 1 THEN 100
    FACTORIAL = N * FACTORIAL(N - 1)
100 FEND

FUNCTION GREETING$(PARAMETER NAME$)
    GREETING$ = "Hello, " + NAME$ + "!"
FEND

FUNCTION HELLO
    PRINT "Hello from a function without parameters!"
FEND

FUNCTION ADD_VALUE(PARAMETER ITEMS, PARAMETER ITEM)
    APPEND ITEMS, ITEM
FEND
